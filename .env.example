# SplitNest — example environment variables (placeholders only)
#
# The app NEVER reads a .env file at runtime. The Gemini API key
# for the AI chatbot is supplied ONLY via a Dart define at build
# or run time:
#
#   flutter run --dart-define=GEMINI_API_KEY=YOUR_KEY
#   flutter build apk --debug --dart-define=GEMINI_API_KEY=YOUR_KEY
#
# In CI, store the key as a GitHub Actions secret named
# GEMINI_API_KEY and pass the same --dart-define flag in the build
# step. Never commit a real key, a real .env file, or this file
# with a value filled in.
GEMINI_API_KEY=
